# --- Runtime ---
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# --- Secrets loading (scripts/start_with_secrets.py) ---
# local: use this .env file. aws: fetch one JSON secret from AWS Secrets Manager.
SECRETS_SOURCE=local
SECRET_ID=
AWS_REGION=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5449/media

# --- Auth ---
# Admin key: creates users and sets quotas. Users authenticate with their own API key.
ADMIN_API_KEY=change-me-admin-key-at-least-32-characters

# --- Storage (StorageProvider): local | s3 ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./data/storage
# Base URL of this API, used in the signed upload/download URLs of the local provider.
PUBLIC_BASE_URL=http://localhost:8000
# HMAC key for those signed URLs.
SIGNING_SECRET=change-me-signing-secret-at-least-32-chars
S3_BUCKET=

# --- Job queue (JobQueue): postgres | sqs ---
JOB_QUEUE=postgres
SQS_QUEUE_URL=
WORKER_POLL_SECONDS=1

# --- Uploads and processing ---
MAX_UPLOAD_BYTES=20000000
# Largest width x height accepted (decompression-bomb guard).
MAX_IMAGE_PIXELS=40000000
DEFAULT_QUOTA_BYTES=100000000
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=300
MAX_PROCESSING_ATTEMPTS=3
# Longest side, in pixels, of each resized variant.
VARIANT_SIZES=large:1024,thumbnail:256
